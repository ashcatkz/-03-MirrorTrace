# ============================================================
#  MirrorTrace — Variables d'environnement
#  Copie ce fichier en .env.local et remplis les clés
# ============================================================

# ----------------------------------------------------------
# 1. OPENAI — GPT-4 pour l'analyse IA des entreprises
#    Inscription : https://platform.openai.com/api-keys
#    Coût : ~0.01€ par analyse (gpt-4o-mini très économique)
# ----------------------------------------------------------
OPENAI_API_KEY=sk-...

# ----------------------------------------------------------
# 2. PAPPERS — Nouvelles immatriculations françaises
#    Inscription GRATUITE : https://www.pappers.fr/api
#    Quota gratuit : 50 requêtes/jour (suffisant pour tester)
#    Quota payant : à partir de 49€/mois pour usage intensif
# ----------------------------------------------------------
PAPPERS_API_KEY=

# ----------------------------------------------------------
# 3. INSEE Sirene — API officielle gouvernementale (GRATUITE)
#    Inscription : https://api.insee.fr
#    1. Créer un compte
#    2. S'abonner à l'API "Sirene" (gratuit)
#    3. Générer un token dans "Mes applications"
#    Avantage : données officielles, aucun quota contraignant
# ----------------------------------------------------------
SIRENE_API_TOKEN=

# ----------------------------------------------------------
# 4. Configuration interne (laisser tel quel pour dev local)
# ----------------------------------------------------------
DASHBOARD_WEBHOOK_URL=http://localhost:3000/api/prospects/ingest
SCRAPER_SECRET=mirrortrace-local-secret-2025
