# ============================================================
#  MirrorTrace — Variables d'environnement
# ============================================================

# ----------------------------------------------------------
# SUPABASE — Persistence des données (prospects survivent aux redémarrages)
#    1. Créer un projet sur https://supabase.com (gratuit)
#    2. Settings > API > Project URL + anon/public key
#    3. Exécuter le SQL ci-dessous dans l'éditeur SQL Supabase
# ----------------------------------------------------------
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------
# RESEND — Email automatique aux nouveaux prospects
#    1. Créer un compte sur https://resend.com (100 emails/jour gratuit)
#    2. API Keys > Create API Key
#    3. Pour prod : vérifier ton domaine dans Resend > Domains
# ----------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXX

# ----------------------------------------------------------
# OPENAI — Optionnel (sans clé = analyse basique par code NAF)
#    Si tu veux l'analyse GPT-4 : platform.openai.com/api-keys
#    ~0.01€ par entreprise analysée
# ----------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------
# Configuration interne — ne pas modifier
# ----------------------------------------------------------
DASHBOARD_WEBHOOK_URL=http://localhost:3000/api/prospects/ingest
SCRAPER_SECRET=mirrortrace-local-secret-2025

