# ============================================================
#  MirrorTrace — Variables d'environnement
# ============================================================

# ----------------------------------------------------------
# OPENAI — Optionnel (sans clé = analyse basique activée)
#    Si tu veux l'analyse GPT-4 : platform.openai.com/api-keys
#    ~0.01€ par entreprise analysée (très économique)
# ----------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------
# Ces clés ne sont plus nécessaires (APIs gratuites utilisées)
# ----------------------------------------------------------
# PAPPERS_API_KEY=       ← remplacé par api.gouv.fr (gratuit)
# SIRENE_API_TOKEN=      ← remplacé par api.gouv.fr (gratuit)

# ----------------------------------------------------------
# Configuration interne — ne pas modifier
# ----------------------------------------------------------
DASHBOARD_WEBHOOK_URL=http://localhost:3000/api/prospects/ingest
SCRAPER_SECRET=mirrortrace-local-secret-2025
